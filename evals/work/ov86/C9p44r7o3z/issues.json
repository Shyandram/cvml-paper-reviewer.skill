{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Only Quest as prior SOTA; token-level training-free selection methods absent.",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "MoA citation points to an image-generation paper.",
   "minor": true
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "H2O and InfLLM wrongly grouped as sliding-window methods.",
   "minor": true
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Related work omits KV-cache quantization methods.",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Novelty mainly a combination of known components such as QuaRot rotation.",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Manhattan estimator interchangeable with L2; not shown to matter.",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "'No information loss' framing overstated; no ranking-error bound under bucketization.",
   "minor": false
  },
  {
   "id": "P2.1",
   "reviewer": "P2",
   "text": "Assumptions behind coarse scoring (attention concentration, shared thresholds) unexamined per layer/head.",
   "minor": false
  },
  {
   "id": "P2.2",
   "reviewer": "P2",
   "text": "Fixed deterministic Hadamard used without comparing randomized variant.",
   "minor": false
  },
  {
   "id": "P2.3",
   "reviewer": "P2",
   "text": "Deployment evidence limited to one GPU, unbatched, no GQA.",
   "minor": false
  },
  {
   "id": "P2.4",
   "reviewer": "P2",
   "text": "No KV-cache capacity saving.",
   "minor": false
  },
  {
   "id": "P2.5",
   "reviewer": "P2",
   "text": "End-to-end speedup measured only up to 32K.",
   "minor": false
  },
  {
   "id": "P2.6",
   "reviewer": "P2",
   "text": "Energy and prefill overhead not reported.",
   "minor": false
  },
  {
   "id": "P2.7",
   "reviewer": "P2",
   "text": "Latency differs little across budgets; no quality-latency Pareto guidance.",
   "minor": false
  },
  {
   "id": "P3.1",
   "reviewer": "P3",
   "text": "Claim of matching full attention at 64 tokens unsupported; 100K passkey weak.",
   "minor": false
  },
  {
   "id": "P3.2",
   "reviewer": "P3",
   "text": "Exactness of Eq. 3 invoked for a quantized L1 pipeline.",
   "minor": false
  },
  {
   "id": "P3.3",
   "reviewer": "P3",
   "text": "Prior SOTA represented only by Quest.",
   "minor": false
  },
  {
   "id": "P3.4",
   "reviewer": "P3",
   "text": "Quest latency not measured; Adamas selection cost higher.",
   "minor": false
  },
  {
   "id": "P3.5",
   "reviewer": "P3",
   "text": "Latency gain from higher sparsity is tiny.",
   "minor": false
  },
  {
   "id": "P3.6",
   "reviewer": "P3",
   "text": "Hadamard ablation confounded by threshold choice.",
   "minor": false
  },
  {
   "id": "P3.7",
   "reviewer": "P3",
   "text": "No quantized-inner-product or oracle top-k control.",
   "minor": false
  },
  {
   "id": "P3.8",
   "reviewer": "P3",
   "text": "L1 and L2 perform similarly.",
   "minor": false
  },
  {
   "id": "P3.9",
   "reviewer": "P3",
   "text": "Lower-than-full perplexity and >2x claims unsupported or setting undefined.",
   "minor": false
  },
  {
   "id": "P3.10",
   "reviewer": "P3",
   "text": "'Remains below baseline' statement false for Qasper.",
   "minor": true
  },
  {
   "id": "P3.11",
   "reviewer": "P3",
   "text": "'Most memory-efficient' claim wrong; 1-bit is smaller.",
   "minor": true
  },
  {
   "id": "P3.12",
   "reviewer": "P3",
   "text": "Latency unit 'us' implausible in Table 2.",
   "minor": true
  },
  {
   "id": "P3.13",
   "reviewer": "P3",
   "text": "Citation and related-work grouping errors.",
   "minor": true
  },
  {
   "id": "P3.14",
   "reviewer": "P3",
   "text": "Hadamard transform cost in Table 4 inconsistent.",
   "minor": true
  },
  {
   "id": "P3.15",
   "reviewer": "P3",
   "text": "No variance or confidence intervals; small differences within noise.",
   "minor": false
  },
  {
   "id": "P4.1",
   "reviewer": "P4",
   "text": "Headline 64-token and near-lossless 128 claims overstated by Tables 1 and 6.",
   "minor": false
  },
  {
   "id": "P4.2",
   "reviewer": "P4",
   "text": "Recall of true top-k or attention-mass coverage never measured.",
   "minor": false
  },
  {
   "id": "P4.3",
   "reviewer": "P4",
   "text": "L1 score on codes not monotone in q\u00b7k; inner-product alternative untested.",
   "minor": false
  },
  {
   "id": "P4.4",
   "reviewer": "P4",
   "text": "L2 matches L1, so Manhattan choice not shown to matter.",
   "minor": false
  },
  {
   "id": "P4.5",
   "reviewer": "P4",
   "text": "Bucketization thresholds never stated.",
   "minor": false
  },
  {
   "id": "P4.6",
   "reviewer": "P4",
   "text": "Hadamard ablation may be confounded by fixed thresholds on raw Q/K.",
   "minor": false
  },
  {
   "id": "P4.7",
   "reviewer": "P4",
   "text": "Quest not timed; Adamas selection FLOPs exceed Quest's.",
   "minor": false
  },
  {
   "id": "P4.8",
   "reviewer": "P4",
   "text": "Batch size unstated for latency measurements.",
   "minor": false
  },
  {
   "id": "P4.9",
   "reviewer": "P4",
   "text": "Table 2 unit 'us' wrong.",
   "minor": true
  },
  {
   "id": "P4.10",
   "reviewer": "P4",
   "text": "Speed measured only up to 32K while accuracy claimed at 100K.",
   "minor": false
  },
  {
   "id": "P4.11",
   "reviewer": "P4",
   "text": "Prefill cost of rotating and packing keys not reported.",
