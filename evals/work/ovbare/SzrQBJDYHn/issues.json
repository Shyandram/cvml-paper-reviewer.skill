{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "No threat model; adversary can estimate low-entropy pattern to evade or forge.",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Some deletions are invisible and short edits match pattern by chance.",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Narrow setup: 64-token texts, small old models, beam decoding, no larger models or code.",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Only random token edits; no human edits, paraphrasing, LLM rewriting or scattered edits.",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Main text shows only one very strong delta setting.",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "No variance or confidence intervals reported.",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Baselines handicapped by forcing KGW/Unigram into the pattern framework.",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "Missing baselines: change-point scans, likelihood-ratio statistic, HC test, segment-level method.",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "Different window sizes for proposed method and baselines confound comparison.",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "High per-position Type-I rate; threshold calibration unclear.",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Text-level false positive rate likely near 1 and unreported.",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "Lenient tolerance; no precision, recall, F1 or AUROC.",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Theory thin: false-alarm bound unusable, unjustified independence, no miss guarantee; provable overstated.",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "Long pattern has weakest quality-detectability trade-off.",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Perplexity only quality metric; no matched-perplexity baseline comparison.",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "Robustness to edits at best comparable to baselines.",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "Novelty moderate; AB a special case of prior work; hand-picked patterns.",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Misinformation test small, without baseline, and overclaimed as realistic threat.",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "Detection accuracy and Type-I definitions loose for insertions and deletions.",
   "minor": true
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "Missing implementation details: key handling, seeds, threshold fitting.",
   "minor": false
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Unclear extension to newer watermarking schemes like embedding-level watermarks.",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "Should validate on more advanced state-of-the-art LLMs.",
   "minor": false
  },
  {
   "id": "Q1.3",
   "reviewer": "Q1",
   "text": "No robustness evaluation against full LLM paraphrasing.",
   "minor": false
  },
  {
   "id": "Q2.1",
   "reviewer": "Q2",
   "text": "Method sacrifices text quality and global detection accuracy for edit detection.",
   "minor": false
  },
  {
   "id": "Q2.2",
   "reviewer": "Q2",
   "text": "Cyclic deterministic watermark vulnerable to knowledgeable adversary.",
   "minor": false
  },
  {
   "id": "Q3.1",
   "reviewer": "Q3",
   "text": "Figure 5 hard to read; exact values table needed.",
   "minor": true
  },
  {
   "id": "Q3.2",
   "reviewer": "Q3",
   "text": "Hard watermark with delta 5.8 likely degrades quality; no quality evaluation.",
   "minor": false
  },
  {
   "id": "Q3.3",
   "reviewer": "Q3",
   "text": "Missing comparison to watermarked-segment detection methods.",
   "minor": false
  },
  {
   "id": "Q4.1",
   "reviewer": "Q4",
   "text": "Related multi-bit watermarking work not cited or compared.",
   "minor": false
  },
  {
   "id": "Q4.2",
   "reviewer": "Q4",
   "text": "Core watermark incremental; benefit of cyclic pattern over arbitrary partitions unclear.",
   "minor": false
  },
  {
   "id": "Q4.3",
   "reviewer": "Q4",
   "text": "Experiments only on short synthetic WikiText prompts.",
   "minor": false
  },
  {
   "id": "Q4.4",
   "reviewer": "Q4",
   "text": "Realistic post-edit scenarios like paraphrasing untested.",
   "minor": false
  }
