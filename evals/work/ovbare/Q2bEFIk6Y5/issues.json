   "text": "No head-to-head comparison with OPFData.",
   "minor": false
  },
  {
   "id": "Q1.15",
   "reviewer": "Q1",
   "text": "Claims of being first and others not maintained are unsupported.",
   "minor": false
  },
  {
   "id": "Q1.16",
   "reviewer": "Q1",
   "text": "Narrow problem scope: single-period, linear-cost, only demand varies, no market features.",
   "minor": false
  },
  {
   "id": "Q1.17",
   "reviewer": "Q1",
   "text": "Topology variation limited to a single removed element.",
   "minor": false
  },
  {
   "id": "Q1.18",
   "reviewer": "Q1",
   "text": "Metrics lack formal definitions, normalization and aggregation.",
   "minor": false
  },
  {
   "id": "Q1.19",
