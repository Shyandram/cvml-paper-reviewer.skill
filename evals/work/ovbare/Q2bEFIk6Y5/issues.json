  },
  {
   "id": "Q1.10",
   "reviewer": "Q1",
   "text": "No verification of AC-OPF local optimality; ground truth may be ambiguous.",
   "minor": false
  },
  {
   "id": "Q1.11",
   "reviewer": "Q1",
   "text": "Keeping only samples feasible for all formulations biases toward easy instances.",
   "minor": false
  },
  {
   "id": "Q1.12",
   "reviewer": "Q1",
   "text": "No information on how often instances lie near infeasibility boundary.",
   "minor": false
  },
  {
   "id": "Q1.13",
