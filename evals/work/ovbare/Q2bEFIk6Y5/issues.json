{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Paper is mainly a dataset introduction without technical advances.",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Variability limited: network structure, node count, connectivity and contingencies not varied enough.",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Only OPF problems; limited fit and generalization for broad ML/OR audience.",
   "minor": false
  },
  {
   "id": "P2.1",
   "reviewer": "P2",
   "text": "Does not go beyond releasing data; lacks scientific or methodological contribution.",
   "minor": false
  },
  {
   "id": "P2.2",
   "reviewer": "P2",
   "text": "ICLR is not a dataset-only venue.",
   "minor": false
  },
  {
   "id": "P2.3",
   "reviewer": "P2",
   "text": "Paper needs polishing.",
   "minor": true
  },
  {
   "id": "P2.4",
   "reviewer": "P2",
   "text": "Demand sampling method is a marginal contribution with little effect on variability.",
   "minor": false
  },
  {
   "id": "P2.5",
   "reviewer": "P2",
   "text": "Status and time-series sampling repeat prior works.",
   "minor": false
  },
  {
   "id": "P2.6",
   "reviewer": "P2",
   "text": "Not convincing that datasets actually capture the claimed load variability.",
   "minor": false
  },
  {
   "id": "P2.7",
   "reviewer": "P2",
   "text": "Global scaling of bus demands imposes unrealistic linear correlation.",
   "minor": false
  },
  {
   "id": "P3.1",
   "reviewer": "P3",
   "text": "Data is still synthetic rather than real-world.",
   "minor": false
  },
  {
   "id": "P3.2",
   "reviewer": "P3",
   "text": "No ML-OPF benchmark results reported on the dataset.",
   "minor": false
  },
  {
   "id": "P3.3",
   "reviewer": "P3",
   "text": "Limited intellectual merit; no new insights on ML for physical systems.",
   "minor": false
  },
  {
   "id": "P3.4",
   "reviewer": "P3",
   "text": "Questionable fit for ICLR; impact limited to narrow ML+OPF community.",
   "minor": false
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "No baseline results, leaderboard or reference numbers despite benchmark claims.",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "No evidence correlated sampling improves model generalization or changes conclusions.",
   "minor": false
  },
  {
   "id": "Q1.3",
   "reviewer": "Q1",
   "text": "Sampling simplistic; no spatial/temporal correlation or comparison with real load statistics.",
   "minor": false
  },
  {
   "id": "Q1.4",
   "reviewer": "Q1",
   "text": "Global range heuristic unjustified and differs per case.",
   "minor": false
  },
  {
   "id": "Q1.5",
   "reviewer": "Q1",
   "text": "Renewable generation variability not modelled; only demand varies.",
   "minor": false
  },
  {
   "id": "Q1.6",
   "reviewer": "Q1",
   "text": "Spline-interpolated time series overstate realism of sub-hourly dynamics.",
   "minor": false
  },
  {
   "id": "Q1.7",
   "reviewer": "Q1",
   "text": "Train/test splitting of time series unspecified; risk of leakage.",
   "minor": false
  },
  {
   "id": "Q1.8",
   "reviewer": "Q1",
   "text": "No statistics on feasibility rates, infeasible split, solver failures or tolerances.",
