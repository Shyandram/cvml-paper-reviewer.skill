{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Realism metrics not compared to real logged data; no WOSAC-style metrics.",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Multimodality and behavior diversity never measured; possible mode collapse.",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Realism metrics author-designed and entangled with reward.",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Claims of consistent superiority not supported by Table 1 infractions.",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Many safety and realism differences lie within standard deviations.",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Conservatism explanation for baselines' lower infractions untested.",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Infractions, progress and TTC are not controllability metrics.",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "Algorithmic novelty is assembly of existing techniques; differs from GRPO baseline only slightly.",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "Ablation shows PPO-Clip better on infractions, unreported in text.",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "Dual-clip stability claim lacks training curves, seed variance, instability evidence.",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Candidate policy probability undefined; ratio explosion rationale unclear.",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "No sensitivity study of clip parameters and update epochs.",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Removing KL argued without ablation.",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "Appendix theory relies on unrealistic assumptions and does not support stability claims.",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "AV evaluation conflates realistic with benign scenarios.",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "No evidence scenarios discriminate planners or reflect real-world performance.",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "PlanT results where RIFT is not best are unacknowledged.",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Blocked Rate metric coarse and measures CBV behavior.",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "Evaluation small: 10 routes, 3 seeds, no held-out towns.",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "No other simulator or dataset such as WOSAC or nuPlan closed loop.",
   "minor": false
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "No statistical tests; Table 2 differences indistinguishable.",
   "minor": false
  },
  {
   "id": "P1.22",
   "reviewer": "P1",
   "text": "Only one backbone, reward family, CBV per scene and planner per type.",
   "minor": false
  },
  {
   "id": "P1.23",
   "reviewer": "P1",
   "text": "Dual-stage framework is standard fine-tuning presented as contribution.",
   "minor": false
  },
  {
   "id": "P1.24",
   "reviewer": "P1",
   "text": "nuPlan-to-CARLA domain gap not studied.",
   "minor": false
  },
  {
   "id": "P1.25",
   "reviewer": "P1",
   "text": "Results depend on reward design; no sensitivity analysis.",
   "minor": false
  },
  {
   "id": "P1.26",
   "reviewer": "P1",
   "text": "Controllability shown only via reward reweighting, not user goals; overclaimed.",
   "minor": false
  },
  {
   "id": "P1.27",
   "reviewer": "P1",
   "text": "Key details scattered in appendix.",
   "minor": true
  },
  {
   "id": "P1.28",
   "reviewer": "P1",
   "text": "Notation inconsistencies; RP values above 100 undefined.",
   "minor": true
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Effect of group-relative term on individual vs collective rewards unanalyzed.",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "Missing related work on GAIL-based driver modeling.",
   "minor": false
  },
  {
   "id": "Q2.1",
   "reviewer": "Q2",
   "text": "No comparison with controllable traffic generation baselines like CTG, LCTGen.",
   "minor": false
  },
  {
   "id": "Q2.2",
   "reviewer": "Q2",
   "text": "Prior group-relative RL fine-tuning work like Gen-Drive not discussed.",
   "minor": false
  },
  {
   "id": "Q2.3",
   "reviewer": "Q2",
   "text": "No dedicated covariate shift analysis comparing SFT and RIFT.",
   "minor": false
  },
  {
   "id": "Q2.4",
   "reviewer": "Q2",
   "text": "Distance-threshold CBV selection unjustified; no TTC-based comparison.",
   "minor": false
  },
  {
   "id": "Q3.1",
   "reviewer": "Q3",
   "text": "CBV identification misses risky intersection vehicles on different routes.",
   "minor": false
  },
  {
   "id": "Q3.2",
   "reviewer": "Q3",
   "text": "Realism evaluated only in simple CARLA; should use Waymo Sim Agent benchmark.",
   "minor": false
  },
  {
   "id": "Q4.1",
   "reviewer": "Q4",
   "text": "Metrics differ from WOSAC; no Sim Agent baselines or evaluation.",
   "minor": false
  },
  {
   "id": "Q4.2",
   "reviewer": "Q4",
   "text": "AV evaluation confounds sim agents and planners; hard to interpret.",
   "minor": false
  }
 ],
