{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Theorem 5.1 circular; key convergence claim deferred to appendix",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Theory relies on infinite rounds/particles, exact policy, alpha->0; practical algorithm uncovered",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Finite-action theorems do not cover continuous-action experiments",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Tension between alpha->0 for ERO and alpha>0 for PRO not formalized",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Experiments anneal alpha to positive tuned value, contradicting ERO-free condition",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "ERO definition and Theorem 5.2 proof sketch informal",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Execution requires sharing other agents' noise; not truly decentralized",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "Shared randomness as correlation device may explain RO removal rather than reasoning",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "Missing comparison with autoregressive/sequential methods such as MAT, HAPPO",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "Narrow toy environments; no standard benchmarks; at most four agents",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Efficiency (wall-clock, compute) never measured",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "Baselines old; modern CTDE and RO methods missing",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Only five seeds with large standard deviations",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "Proposed method tuned with TPE; baselines may lack equal budget",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Text and Fig. 4 caption contradict on effect of s^2",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "Meaning of plus-minus unstated; curves show reward variance not CI",
   "minor": true
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "Gains may stem from SVGD particle exploration; exploration baselines missing",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Full-conditioning ablation performs comparably; nested structure not shown necessary",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "No ablations on particles, rounds, amortization or alpha schedule",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "No experiment directly measures PRO/ERO or consistency condition",
   "minor": false
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Limited novelty: inference ingredients from prior work",
   "minor": false
  },
  {
   "id": "P1.22",
   "reviewer": "P1",
   "text": "Connections to autoregressive policies, coordination graphs, correlated equilibrium undiscussed",
   "minor": false
  },
  {
