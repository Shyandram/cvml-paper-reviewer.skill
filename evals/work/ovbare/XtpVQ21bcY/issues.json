{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Requiring attention scores appears incompatible with FlashAttention",
   "minor": false
  },
  {
   "id": "P2.1",
   "reviewer": "P2",
   "text": "Block-wise probing methods (NSA, MoBA, SeerAttention, ZipVL) obtain scores with FlashAttention",
   "minor": false
  },
  {
   "id": "P2.2",
   "reviewer": "P2",
   "text": "Top-p dynamic KV methods like Twilight and ZipVL already exist",
   "minor": false
  },
  {
   "id": "P2.3",
   "reviewer": "P2",
   "text": "Only compared against StreamingLLM and H2O",
   "minor": false
  },
  {
   "id": "P2.4",
   "reviewer": "P2",
   "text": "Need VideoMME, LongVideoBench, PerceptionTest, ActNet-QA, NextQA benchmarks",
   "minor": false
  },
  {
   "id": "P2.5",
   "reviewer": "P2",
   "text": "Need evaluation on long videos exceeding 20k context",
   "minor": false
  },
  {
   "id": "P2.6",
   "reviewer": "P2",
   "text": "More extensive experiments on LLaVA-Video expected",
   "minor": false
  },
  {
   "id": "P2.7",
   "reviewer": "P2",
   "text": "Cross-layer dropping unnecessary versus fine-grained selection; risks compounding information loss",
   "minor": false
  },
  {
   "id": "P3.1",
   "reviewer": "P3",
   "text": "Should compare with AdaKV, PyramidKV, HeadKV, PruneVID",
   "minor": false
  },
  {
   "id": "P3.2",
   "reviewer": "P3",
   "text": "Figure 1(c) should more clearly show dense vs ST-SpAttn differences",
   "minor": true
  },
  {
   "id": "P3.3",
   "reviewer": "P3",
   "text": "Needs formal analysis why lower-layer scores suffice for high-layer importance",
   "minor": false
  },
  {
   "id": "P3.4",
   "reviewer": "P3",
   "text": "Ablation lacks analysis of PureKV computational overhead",
   "minor": false
  },
  {
   "id": "P3.5",
   "reviewer": "P3",
   "text": "Overall writing could be clearer and more readable",
   "minor": true
  },
  {
   "id": "P4.1",
   "reviewer": "P4",
   "text": "Attention-based importance scoring and sparse attention are not individually novel",
   "minor": false
  },
  {
   "id": "P4.2",
   "reviewer": "P4",
   "text": "Choice of layers for CLIE vs ST-SpAttn is empirical, lacking principled framework",
   "minor": false
  },
  {
   "id": "P4.3",
   "reviewer": "P4",
   "text": "Audio-visual results only in appendix; test Qwen2-Audio or Omni models",
   "minor": false
  },
  {
   "id": "P4.4",
   "reviewer": "P4",
   "text": "Better results at 10% than 20% budget need investigation",
   "minor": false
  },
  {
   "id": "P4.5",
   "reviewer": "P4",
   "text": "Only single-query evaluation; multi-turn cache reuse not shown",
   "minor": false
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Spearman correlations of 0.2-0.4 do not support 'sufficient statistic' claim",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "No top-h recall, output-error or attention-mass recovery metric",
   "minor": false
  },
  {
   "id": "Q1.3",
   "reviewer": "Q1",
   "text": "No theory supports the sufficient-statistic claim",
   "minor": false
  },
  {
   "id": "Q1.4",
   "reviewer": "Q1",
   "text": "Number of samples used for correlation not stated",
   "minor": true
  },
  {
   "id": "Q1.5",
   "reviewer": "Q1",
   "text": "Purification claim rests on qualitative figure; gain may come from sink-like prior",
   "minor": false
  },
  {
   "id": "Q1.6",
   "reviewer": "Q1",
   "text": "Ablation Table 4 uses a single task",
   "minor": false
  },
  {
   "id": "Q1.7",
   "reviewer": "Q1",
   "text": "Ablation differences small; no variance, seeds or CIs anywhere",
   "minor": false
  },
  {
   "id": "Q1.8",
   "reviewer": "Q1",
   "text": "No ablation with ST-SpAttn but without CLIE",
   "minor": false
  },
  {
   "id": "Q1.9",
   "reviewer": "Q1",
   "text": "Ablation never shows a benefit from CLIE",
   "minor": false
  },
  {
   "id": "Q1.10",
   "reviewer": "Q1",
   "text": "PureKV changes prefill while baselines keep dense; Table 6 ambiguous",
   "minor": false
  },
  {
   "id": "Q1.11",
   "reviewer": "Q1",
   "text": "PureKV at 20% beats full cache, suggesting noise or metric issue",
   "minor": false
  },
  {
   "id": "Q1.12",
   "reviewer": "Q1",
   "text": "LOOK-M scores near zero, likely integration failure inflating margins",
   "minor": false
  },
  {
   "id": "Q1.13",
   "reviewer": "Q1",
   "text": "Baselines collapse on VideoLLaMA2; tuning details not given",
   "minor": false
  },
  {
   "id": "Q1.14",
   "reviewer": "Q1",
   "text": "VideoLLaMA2 drops substantially at 10-20%, contradicting negligible degradation",
   "minor": false
  },
  {
   "id": "Q1.15",
   "reviewer": "Q1",
   "text": "Task subset differs from list and per model; selection unexplained",
   "minor": false
  },
  {
   "id": "Q1.16",
   "reviewer": "Q1",
   "text": "ROUGE used for multiple-choice instead of accuracy",
   "minor": false
  },
  {
   "id": "Q1.17",
   "reviewer": "Q1",
   "text": "No Video-MME, LongVideoBench, MLVU or EgoSchema evaluation",
   "minor": false
  },
  {
   "id": "Q1.18",
   "reviewer": "Q1",
   "text": "Only two models evaluated",
   "minor": false
  },
  {
   "id": "Q1.19",
   "reviewer": "Q1",
   "text": "AVSD result barely above baselines yet called significant",
   "minor": false
  },
  {
   "id": "Q1.20",
   "reviewer": "Q1",
   "text": "3.16x speedup in ms/token without sequence length, batch or frames",
   "minor": false
  },
  {
   "id": "Q1.21",
   "reviewer": "Q1",
   "text": "Speedup comes from ST-SpAttn, not compression; headline numbers from different configs",
   "minor": false
  },
  {
   "id": "Q1.22",
   "reviewer": "Q1",
   "text": "No latency or throughput comparison to baselines despite faster-decoding claim",
   "minor": false
  },
  {
   "id": "Q1.23",
   "reviewer": "Q1",
   "text": "Peak memory not reported",
   "minor": false
  },
  {
   "id": "Q1.24",
   "reviewer": "Q1",
   "text": "Selection after high-layer K/V computed, so peak prefill memory not reduced",
   "minor": false
  },
  {
   "id": "Q1.25",
   "reviewer": "Q1",
   "text": "Unclear whether sparse pattern uses block-sparse kernel or masking",
   "minor": false
  },
  {
   "id": "Q1.26",
   "reviewer": "Q1",
   "text": "Frame token correspondence for merged patches in Qwen2.5-VL not explained",
   "minor": false
  },
  {
   "id": "Q1.27",
   "reviewer": "Q1",
   "text": "How text query tokens attend and interact with ST-SpAttn is unknown",
   "minor": false
  },
  {
   "id": "Q1.28",
   "reviewer": "Q1",
   "text": "Head/GQA aggregation, h, w and per-layer budgets omitted",
   "minor": false
  },
  {
   "id": "Q1.29",
   "reviewer": "Q1",
   "text": "Best CLIE/ST-SpAttn layers selected on the same reported task",
   "minor": false
  },
  {
   "id": "Q1.30",
   "reviewer": "Q1",
   "text": "CLIE at layer 0 fails catastrophically, suggesting fragility",
   "minor": false
  },
  {
   "id": "Q1.31",
   "reviewer": "Q1",
   "text": "Resembles FastV, GemFilter, ZipCache, StreamingLLM, Sparse VideoGen; not compared",
   "minor": false
  },
  {
   "id": "Q1.32",
   "reviewer": "Q1",
   "text": "Claim that no sparse attention scheme interacts with KV compression too strong",
   "minor": false
  },
  {
   "id": "Q1.33",
   "reviewer": "Q1",
   "text": "Wrong table order cited, budget mismatch, AC label reused for different tasks",
   "minor": true
  },
  {
   "id": "Q1.34",
   "reviewer": "Q1",
   "text": "Several references unrelated to the paper",
   "minor": true
  },
  {
   "id": "Q1.35",
   "reviewer": "Q1",
   "text": "No limitations section",
   "minor": true
  }
 ],
