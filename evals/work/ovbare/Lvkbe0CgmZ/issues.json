{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Discrete-time bound in Thm 4.3 vacuous (D infinite) for barrier mirror maps; general-X claim unacknowledged.",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Uniform LSI assumption stated with Euclidean Fisher information but proof uses mirror Fisher information.",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "No example verifying a uniform mirror LSI; no mirror analogue of standard LSI criteria.",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Uniform-in-N mirror LSI simply assumed, carrying most of propagation-of-chaos difficulty.",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Theorem assumption lists inconsistent with assumptions actually used in proofs.",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Rate in (20) lacks M-dependence despite G0 vs Hessian comparison only up to factor M.",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Errors in Lemma B.2 and inconsistent delta_eta formula between (21) and Thm 4.3.",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "W_{2,phi} asymmetric and not a metric; relative Lipschitz condition never verified for any example.",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "Typos and wrong equation references.",
   "minor": true
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "Analysis assumes exact diffusion simulation; experiments use unanalyzed one-step discretization.",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Propagation-of-chaos result specialized to supervised risk; assumptions not verified on constrained domains.",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "Thm 4.1 reuses Nit24 verbatim and is not mirror-specific.",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Only one d=3 synthetic experiment; no neural-network or realistic application.",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "No seeds or error bars in experiments.",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Only projected MFLD baseline; reflected, barrier and other mirror methods missing.",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "Projected baseline failure is built into barrier objective; loss comparison confounded by entropy accounting.",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "No empirical test of discretization, N or step-size dependence predicted by theory.",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "'First algorithm with global convergence' claim too strong given prior constrained mean-field work.",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "Technical content largely substitutes mirror metric into existing proofs; limited novelty.",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "Paper short, workshop-like; preliminaries recap too long.",
   "minor": true
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Missing algorithmic discussion of computing grad phi*, Hessians and exact diffusion for general X.",
   "minor": false
  },
  {
   "id": "P1.22",
   "reviewer": "P1",
   "text": "No discussion of computational cost versus projection.",
   "minor": false
  },
  {
   "id": "P1.23",
   "reviewer": "P1",
   "text": "Limitations such as mirror LSI strength and infinite D not discussed.",
   "minor": false
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Practical applicability unclear due to strong assumptions.",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "Empirical results limited and toy-level.",
   "minor": false
  },
  {
   "id": "Q1.3",
   "reviewer": "Q1",
   "text": "Scheme not a genuine discretization; assumes exact Brownian motion simulation.",
   "minor": false
  },
  {
   "id": "Q1.4",
   "reviewer": "Q1",
   "text": "Analysis builds largely on prior results (Ahn & Chewi, Vempala & Wibisono); limited novelty.",
   "minor": false
  },
  {
   "id": "Q2.1",
   "reviewer": "Q2",
   "text": "Motivation weak; should show new settings unlocked, e.g. constrained networks or generative modeling.",
   "minor": false
  },
  {
   "id": "Q2.2",
   "reviewer": "Q2",
   "text": "Discretization cost of Step 5 unanalyzed; no discussion why it is easier than Brownian motion on X.",
   "minor": false
  },
  {
   "id": "Q3.1",
   "reviewer": "Q3",
   "text": "Theorems are standard extensions of Nitanda et al.; more synthesis than novel ideas.",
   "minor": false
  },
  {
   "id": "Q3.2",
   "reviewer": "Q3",
   "text": "Only one low-dimensional experiment barely showing advantage.",
   "minor": false
  },
  {
   "id": "Q3.3",
   "reviewer": "Q3",
   "text": "Little motivating example for why constrained sampling matters in ML.",
   "minor": false
  },
  {
   "id": "Q4.1",
   "reviewer": "Q4",
   "text": "Proof techniques borrowed from prior papers; limited technical novelty.",
   "minor": false
  },
  {
   "id": "Q4.2",
   "reviewer": "Q4",
   "text": "Exact simulation of diffusion step assumed, creating gap with one-step implementation.",
   "minor": false
  },
  {
   "id": "Q4.3",
   "reviewer": "Q4",
   "text": "Discrete-time analysis only for mean-field neural network risk; limited generality.",
   "minor": false
  }
 ],
