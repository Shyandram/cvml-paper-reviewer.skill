{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Settings are small and synthetic; misbehavior programmatically injected; no naturally occurring cases.",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Undesired behaviors are clean, nameable and known in advance.",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Motivation (frontier oversight, RL reward hacking) far from tested SFT settings.",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Models are small (2B-8B) and mostly older.",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Training and evaluation prompts selected on test metrics; best-of-N without validation set.",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Heuristic validation is post hoc; no test that argmax-elicitation picks the best prompt.",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Heuristic correlations weak, few points, no confidence intervals, one setting excluded.",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "Elicitation heuristic fails when model does not follow the instruction.",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "Mechanism unexplained; alternative explanations like conditional policies not tested.",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "IP can increase compliance with harmful requests when instructed.",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Capabilities measured narrowly; no general benchmarks; some capability drops.",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "Brittle: single-word prompt changes flip effectiveness.",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Effectiveness decays with more training; reported only qualitatively.",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "Slight improvements claimed without significance tests.",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Narrow toxicity metric and single LLM judge; judge bias untested.",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "Qwen-2 base works without elicitation, undermining claimed mechanism.",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "Only PTST baseline; no training-time baselines like filtering or steering.",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Persona-vector steering, closest prior work, not compared.",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "Claim that IP needs no labels is misleading; requires knowing affected data.",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "Key results relegated to appendix; crowded figures hard to read.",
   "minor": true
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Wording overreaches: prevents behavior, consistently outperforms weak PTST.",
   "minor": false
  },
  {
   "id": "P1.22",
   "reviewer": "P1",
   "text": "Preliminary experiments on instruction placement not shown.",
   "minor": true
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Method heuristic without mechanistic explanation.",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "Small-scale controlled datasets with narrow metrics; generalization unclear.",
   "minor": false
  },
  {
   "id": "Q1.3",
   "reviewer": "Q1",
   "text": "Improvements modest, possibly within fine-tuning noise.",
   "minor": false
  },
  {
   "id": "Q1.4",
   "reviewer": "Q1",
   "text": "Effect brittle across models, reversing with longer training or larger models.",
   "minor": false
  },
  {
   "id": "Q1.5",
   "reviewer": "Q1",
   "text": "Results highly sensitive to inoculation prompt wording.",
   "minor": false
  },
  {
   "id": "Q1.6",
   "reviewer": "Q1",
   "text": "Approach is ad hoc prompt manipulation rather than algorithmic innovation.",
   "minor": false
  },
  {
   "id": "Q2.1",
   "reviewer": "Q2",
   "text": "Tasks scriptable; behavior nameable in one line, unlike real failures.",
   "minor": false
  },
  {
   "id": "Q2.2",
   "reviewer": "Q2",
   "text": "Prompt-selection heuristic assumes failure can be cheaply elicited.",
   "minor": false
  },
  {
   "id": "Q2.3",
   "reviewer": "Q2",
   "text": "OOD and compositional attacks not evaluated; evaluations isomorphic to training.",
   "minor": false
  },
  {
   "id": "Q2.4",
   "reviewer": "Q2",
   "text": "Scope narrower than general misalignment-mitigation framing.",
   "minor": false
  },
  {
   "id": "Q2.5",
   "reviewer": "Q2",
   "text": "Needs stronger baselines.",
   "minor": false
  },
  {
   "id": "Q3.1",
   "reviewer": "Q3",
   "text": "Figures use coded labels defined only in appendix.",
   "minor": true
  },
  {
   "id": "Q4.1",
   "reviewer": "Q4",
   "text": "Near-total overlap with concurrent Inoculation Prompting work weakens originality.",
   "minor": false
  },
  {
   "id": "Q4.2",
   "reviewer": "Q4",
   "text": "Concurrent work covers more fundamental settings, making contribution incremental.",
   "minor": false
  },
  {
   "id": "Q4.3",
   "reviewer": "Q4",
   "text": "Minor wording change greatly reduces effectiveness; brittle.",
   "minor": false
  },
  {
   "id": "Q4.4",
   "reviewer": "Q4",
   "text": "Requires a priori knowledge of undesired behavior; unforeseen behaviors untested.",
   "minor": false
  }
 ],
