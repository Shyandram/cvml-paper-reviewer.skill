{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "No human evaluation of cultural appropriateness; cosine similarity only a proxy; few prompts",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "GPT embeddings plus GPT judge raises circularity and bias concerns",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Universal steering vector evidence limited; needs ablations on robustness, sparsity, side-effects",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Should include more low-resource languages",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Should study cultures sharing the same language, e.g. US, UK, Australia",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Culture vaguely operationalized; unclear which aspects each dataset tests",
   "minor": false
  },
  {
   "id": "P2.1",
   "reviewer": "P2",
   "text": "Paper hard to follow; confusing dataset descriptions and ungrammatical key sentences",
   "minor": true
  },
  {
   "id": "P2.2",
   "reviewer": "P2",
   "text": "Activation patching and steering procedure, token positions, D+/D- unclear; localization claim hard to follow",
   "minor": false
  },
  {
   "id": "P2.3",
   "reviewer": "P2",
   "text": "Labels like correct English/translated answer undefined; Figure 1 uninterpretable",
   "minor": true
  },
  {
   "id": "P2.4",
   "reviewer": "P2",
   "text": "Cosine similarity of embeddings uninformative of homogeneity; value differences uninterpretable",
   "minor": false
  },
  {
   "id": "P2.5",
   "reviewer": "P2",
   "text": "Using ChatGPT as cultural judge is questionable",
   "minor": false
  },
  {
   "id": "P2.6",
   "reviewer": "P2",
   "text": "Refusal rates hard to interpret without dataset sizes",
   "minor": true
  },
  {
   "id": "P3.1",
   "reviewer": "P3",
   "text": "Three of four benchmarks are new without information validating their effectiveness",
   "minor": false
  },
  {
   "id": "P3.2",
   "reviewer": "P3",
   "text": "Chosen languages span multiple cultures, e.g. Bengali in Bangladesh and India",
   "minor": false
  },
  {
   "id": "P4.1",
   "reviewer": "P4",
   "text": "Assumption that language alone implicitly signals locale is problematic",
   "minor": false
  },
  {
   "id": "P4.2",
   "reviewer": "P4",
   "text": "One-to-one language-country mapping may be untrue",
   "minor": false
  },
  {
   "id": "P4.3",
   "reviewer": "P4",
   "text": "Stereotyping not formally defined",
   "minor": false
  },
  {
   "id": "P4.4",
   "reviewer": "P4",
   "text": "Stereotyping measured only with LLM judge; human evaluation needed",
   "minor": false
  },
  {
   "id": "P4.5",
   "reviewer": "P4",
   "text": "No statistical significance test for Table 1",
   "minor": false
  },
  {
   "id": "P4.6",
   "reviewer": "P4",
   "text": "Judge prompt lacks option for none being stereotypical",
   "minor": false
  },
  {
   "id": "P4.7",
   "reviewer": "P4",
   "text": "Comparative judging may differ from individual scoring; robustness unchecked",
   "minor": false
  },
  {
   "id": "P4.8",
   "reviewer": "P4",
   "text": "EI gap as subtraction of probability distributions is unclear",
   "minor": false
  },
  {
   "id": "P4.9",
   "reviewer": "P4",
   "text": "Paper hard to read; Sections 3.2-3.3 unclear; undefined jargon",
   "minor": true
  },
  {
   "id": "P4.10",
   "reviewer": "P4",
   "text": "Figure 3 formatting inconsistent font sizes and axis ranges",
   "minor": true
  },
  {
   "id": "P4.11",
   "reviewer": "P4",
   "text": "Representational universality claim not validated statistically",
   "minor": false
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Binary benchmark always includes American option, exploitable by picking non-American",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "Names and cities tasks tiny, synthetic, easy; gap not evidence of cultural competence",
   "minor": false
  },
  {
   "id": "Q1.3",
   "reviewer": "Q1",
   "text": "o1-distilled questions and translations not validated by native speakers",
   "minor": false
  },
  {
   "id": "Q1.4",
   "reviewer": "Q1",
   "text": "Localized answers ignore intra-country variation",
   "minor": false
  },
  {
   "id": "Q1.5",
   "reviewer": "Q1",
   "text": "EI-Gap conflates language effects with context effects",
   "minor": false
  },
  {
   "id": "Q1.6",
   "reviewer": "Q1",
   "text": "Large unexplained gap in United States row",
   "minor": false
  },
  {
   "id": "Q1.7",
   "reviewer": "Q1",
   "text": "EI-Gap defined with probabilities but reported as accuracy differences",
   "minor": false
  },
  {
   "id": "Q1.8",
   "reviewer": "Q1",
   "text": "Gap reported without uncertainty or significance testing",
   "minor": false
  },
  {
   "id": "Q1.9",
   "reviewer": "Q1",
   "text": "Explicit prompting weak baseline; gap may be prompt-format sensitivity",
   "minor": false
  },
  {
   "id": "Q1.10",
   "reviewer": "Q1",
   "text": "No comparison with persona system prompts, few-shot, or fine-tuning",
   "minor": false
  },
  {
   "id": "Q1.11",
   "reviewer": "Q1",
   "text": "Steering underperforms explicit prompting; customization claim overstated",
   "minor": false
  },
  {
   "id": "Q1.12",
   "reviewer": "Q1",
   "text": "Embedding-based homogeneity metric unvalidated; differences tiny",
   "minor": false
  },
  {
   "id": "Q1.13",
   "reviewer": "Q1",
   "text": "Steering diversity comparison on one model, differences not significant",
   "minor": false
  },
  {
   "id": "Q1.14",
   "reviewer": "Q1",
   "text": "Only 24 stories for open-ended evaluation",
   "minor": false
  },
  {
   "id": "Q1.15",
   "reviewer": "Q1",
   "text": "Stereotype and faithfulness judged by LLM without human validation or bias checks",
   "minor": false
  },
  {
   "id": "Q1.16",
   "reviewer": "Q1",
   "text": "Fewer stereotypes may reflect less localization rather than better output",
   "minor": false
  },
  {
   "id": "Q1.17",
   "reviewer": "Q1",
   "text": "Mechanistic analysis only on Gemma-2-9b; universal mechanism claims unbacked",
   "minor": false
  },
  {
   "id": "Q1.18",
   "reviewer": "Q1",
   "text": "Interpretation of patching probability curves speculative",
   "minor": false
  },
  {
   "id": "Q1.19",
   "reviewer": "Q1",
   "text": "Steering hyperparameter selection unclear; possibly tuned on evaluation set",
   "minor": false
  },
  {
   "id": "Q1.20",
   "reviewer": "Q1",
   "text": "No random-vector controls; vector may encode country mention or non-American bias",
   "minor": false
  },
  {
   "id": "Q1.21",
   "reviewer": "Q1",
   "text": "Universal vector overclaimed: four cultures, modest gains, not rigorously evaluated",
   "minor": false
  },
  {
   "id": "Q1.22",
   "reviewer": "Q1",
   "text": "Country-equals-language assumption ignores multi-country languages",
   "minor": false
  },
  {
   "id": "Q1.23",
   "reviewer": "Q1",
   "text": "Few languages and models; no reasoning or frontier models",
   "minor": false
  },
  {
   "id": "Q1.24",
   "reviewer": "Q1",
   "text": "GPT-4o high refusal rate complicates its numbers",
   "minor": false
  },
  {
   "id": "Q1.25",
   "reviewer": "Q1",
   "text": "English-centric default shown only on forced-choice tasks",
   "minor": false
  },
  {
   "id": "Q1.26",
   "reviewer": "Q1",
   "text": "Steering requires white-box access, excluding popular chatbots",
   "minor": false
  },
  {
   "id": "Q1.27",
   "reviewer": "Q1",
   "text": "Unclear whether steering works on longer real conversations",
   "minor": false
  },
  {
   "id": "Q1.28",
   "reviewer": "Q1",
   "text": "Key details deferred to appendix",
   "minor": true
  },
  {
   "id": "Q1.29",
   "reviewer": "Q1",
   "text": "Figures 2 and 3 are dense heatmaps",
   "minor": true
  },
  {
   "id": "Q1.30",
   "reviewer": "Q1",
   "text": "Sloppy statements, e.g. relative vs absolute gap unclear",
   "minor": true
  }
