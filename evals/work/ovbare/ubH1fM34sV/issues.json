   "text": "Results not situated within latest leaderboard trends",
   "minor": false
  },
  {
   "id": "Q3.3",
   "reviewer": "Q3",
   "text": "No investigation of why some methods outperform the proposed approach",
   "minor": false
  },
  {
   "id": "Q3.4",
