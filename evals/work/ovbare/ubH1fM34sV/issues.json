{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "No attention analysis showing model uses nearest RULER token; mechanism untested",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "No error analysis, e.g. error versus distance to nearest RULER token",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "No controlled resolution-extrapolation experiment",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "ScreenSpot-Pro differs in domain too, so resolution generalization not isolated",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Gains small with single runs, no significance; sub-split regressions; consistency claim overstated",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Unclear whether fine-tuning baseline is off-the-shelf or fine-tuned without RULER",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Introduction compares models with different base models and data",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "Distribution-shift cost of adding RULER only at fine-tuning unexamined",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "No baselines against alternative explicit-coordinate designs under identical settings",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "No ablation with shuffled or misaligned RULER tokens",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "I-MRoPE novelty overclaimed given Qwen3-VL and frequency-allocation work",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "Evidence for I-MRoPE benefit is tiny gain without variance",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Confusing h/t notation in Eq. 8",
   "minor": true
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "I-MRoPE never tested in fine-tuning setting",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Results well below UI-TARS and GUI-Actor; benefit in competitive regime unshown",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "Baseline numbers mix copied and reproduced results with unspecified transformations",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "Scope narrow: only 7B models, web-only data, one high-resolution benchmark",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "No agentic end-to-end evaluation like OSWorld or AndroidWorld",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "Claim of preserved general VLM capability unsupported",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "Square-patch and shared h/w assumptions limit aspect-ratio handling",
   "minor": false
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Large residual offsets with s=8 do not fit bounded-arithmetic story for small icons",
   "minor": false
  },
  {
   "id": "P1.22",
   "reviewer": "P1",
   "text": "Multi-image and multi-turn behavior barely discussed",
   "minor": false
  },
  {
   "id": "P1.23",
   "reviewer": "P1",
   "text": "Inference latency reported only as token ratios, not wall-clock",
   "minor": false
  },
  {
   "id": "P1.24",
   "reviewer": "P1",
   "text": "Interval analysis inconclusive; gains may be generic extra-token effect",
   "minor": false
  },
  {
   "id": "P1.25",
   "reviewer": "P1",
   "text": "Presentation errors: wrong symbol, contradicted percentage, garbled benchmark description",
   "minor": true
  },
  {
   "id": "P1.26",
   "reviewer": "P1",
   "text": "Hyperparameters only in appendix",
   "minor": true
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Models underperform UI-TARS and GUI-Actor; data explanation insufficient",
   "minor": false
  },
  {
   "id": "Q1.2",
