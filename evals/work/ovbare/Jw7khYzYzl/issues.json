{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Hyperparameters tuned at one near-Chinchilla horizon then frozen; long-horizon rankings confounded.",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Conclusions (SOAP vs AdEMAMix) flip depending on beta re-tuning; sensitive to tuning protocol.",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Search grids and tuning effort differ by optimizer; extra hyperparameters may explain wins.",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "No memory or throughput normalization despite differing optimizer state costs.",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Single-seed results; small loss gaps may be noise; ranking stability claims lack confidence intervals.",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Scale modest (720M, 48B tokens) relative to LLM pretraining claims; extrapolation to 1B+ risky.",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Context length only 512 tokens.",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "720M experiments cover few durations and one batch size; 583M compares only two optimizers.",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "MoE transfer claim rests on one small untuned MoE and is partly contradicted.",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "Evaluation is validation loss only; no downstream tasks or cost-to-target-loss.",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Explanations (Prodigy emulates AdamW, Lion similar to AdEMAMix) asserted without test.",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "Sophia dropped from small-batch setting after divergence, biasing the comparison.",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Muon vs D-Muon gap attributed to weight decay without isolated ablation.",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "Claim that Muon degrades with model size is based on only three sizes.",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Limited novelty; several findings reproduce known results.",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "'First large-scale controlled benchmark' claim overstated given AlgoPerf and other benchmarks.",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "Contradictions with earlier work asserted without controlled reproduction of their setups.",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Text long and takeaway-heavy; key evidence relegated to appendix.",
   "minor": true
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "No main-text table of final losses; rankings read from figures.",
   "minor": true
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "Loose unquantified wording such as 'huge gap', 'remarkably'.",
   "minor": true
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Frequent typos and grammar problems.",
   "minor": true
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "512 context length too short for practical LLMs; may change conclusions.",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "Training iterations too many / batch size too small versus practical training; may alter conclusions.",
   "minor": false
  },
  {
   "id": "Q1.3",
   "reviewer": "Q1",
   "text": "No severe over-training regime with short iteration counts.",
   "minor": false
  },
  {
   "id": "Q1.4",
   "reviewer": "Q1",
   "text": "Optimizers may differ in effective learning rate; normalizing update RMS could change claims.",
   "minor": false
  },
  {
   "id": "Q2.1",
   "reviewer": "Q2",
   "text": "Lacks deep insight into why optimizers show their dynamics; only pairwise comparisons.",
   "minor": false
  },
  {
   "id": "Q2.2",
   "reviewer": "Q2",
   "text": "Some takeaways are well known and not new.",
   "minor": false
  },
  {
   "id": "Q2.3",
   "reviewer": "Q2",
   "text": "No concluding guidance on best optimizer, robust hyperparameter ranges or failure cases.",
   "minor": false
  },
  {
   "id": "Q2.4",
   "reviewer": "Q2",
   "text": "Only curated FineWeb data; data heterogeneity not explored.",
   "minor": false
  },
  {
   "id": "Q2.5",
   "reviewer": "Q2",
   "text": "Model sizes too small compared with typical ablation practice.",
   "minor": false
  },
  {
   "id": "Q2.6",
   "reviewer": "Q2",
   "text": "Excess vertical space; figures overlap text.",
   "minor": true
  },
  {
   "id": "Q3.1",
   "reviewer": "Q3",
   "text": "Experiments limited in scale; largest model 720M.",
   "minor": false
  },
  {
   "id": "Q3.2",
   "reviewer": "Q3",
   "text": "Only validation loss; no downstream benchmarks like MMLU or GLUE.",
   "minor": false
  },
  {
   "id": "Q3.3",
   "reviewer": "Q3",
   "text": "Presentation crowded.",
   "minor": true
  },
  {
   "id": "Q4.1",
   "reviewer": "Q4",
   "text": "No comparison of computational resource and time costs of optimizers.",
   "minor": false
  },
  {
   "id": "Q4.2",
   "reviewer": "Q4",
   "text": "Models small relative to existing LLMs; uncertain practical conclusions.",
   "minor": false
  },
  {
   "id": "Q4.3",
   "reviewer": "Q4",
   "text": "Selection schemes heuristic, lacking theoretical guidance or selection principles.",
   "minor": false
  },
  {
   "id": "Q4.4",
   "reviewer": "Q4",
   "text": "Should add discussion of limitations and future work.",
   "minor": true
  }
 ],
