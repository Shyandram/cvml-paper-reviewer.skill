{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Only harm studied is string-matched leakage of synthetic user data",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Training and evaluation attackers share generator; evaluation mostly in-distribution",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Average-over-attackers dominated by ARLAS attacker; baseline attackers weak",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "No evaluation against independent attacks like static suites, GCG, human red-teaming",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "No comparison with other defenses like instruction hierarchy, StruQ, spotlighting, detectors",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Seed standard errors may not capture training variance; unclear what seeds vary",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "AgentDojo gains about one point, matched by SPAG; generalization overclaimed",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "AgentDojo attack configuration and ASR definition unspecified; low base ASR suggests weak attack",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "Task success under ARLAS attacker much lower; trade-off claim weakened",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "No-attack task success gain comes from SFT/RL, not the safety method",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Absolute ASR under ARLAS attacker remains high",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "Embedding-distance diversity metric weak; cumulative set inflates it; collapse undetectable",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Attack diversity not compared with baselines",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "No semantic or strategy-level analysis of attacks; few qualitative views",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Over-refusal on tasks legitimately needing private data untested",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "Robustness to other harms like unauthorized tool calls untested",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "Baselines adapted and underspecified; tuning effort unclear",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Baseline attackers suspiciously weak, suggesting implementation issues",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "ARLAS vs no-PBL effect modest and on one base model",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "No sensitivity analysis on population size or sampling; extra compute undiscussed",
   "minor": false
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Cycling in iterative baseline never measured, so PBL motivation untested",
   "minor": false
  },
  {
   "id": "P1.22",
   "reviewer": "P1",
   "text": "Limited novelty: combination of known self-play, population, GRPO ingredients",
   "minor": false
  },
  {
   "id": "P1.23",
   "reviewer": "P1",
   "text": "No theoretical argument why past-checkpoint sampling avoids cycling",
   "minor": false
  },
  {
   "id": "P1.24",
   "reviewer": "P1",
   "text": "Reward design gives poor incentives for attacker and agent",
   "minor": false
  },
  {
   "id": "P1.25",
   "reviewer": "P1",
   "text": "Game not strictly zero-sum as claimed",
   "minor": false
  },
  {
   "id": "P1.26",
   "reviewer": "P1",
   "text": "Imitation data from larger same-family models may pass on teacher patterns",
   "minor": false
  },
  {
   "id": "P1.27",
   "reviewer": "P1",
   "text": "Training scale small: LoRA, short horizons, few tasks and iterations",
   "minor": false
  },
  {
   "id": "P1.28",
   "reviewer": "P1",
   "text": "No code release mentioned",
   "minor": false
  },
  {
   "id": "P1.29",
   "reviewer": "P1",
   "text": "Missing RL steps, evaluation set sizes, test task counts",
   "minor": false
  },
  {
   "id": "P1.30",
   "reviewer": "P1",
   "text": "Only 12-14B models used; generality limited",
   "minor": false
  },
  {
   "id": "P1.31",
   "reviewer": "P1",
   "text": "Typos, mislabeled appendix prompt, sign error in Eq. 2",
   "minor": true
  },
  {
   "id": "P1.32",
   "reviewer": "P1",
   "text": "Main results shown only as dense heatmaps",
   "minor": true
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Limited novelty: combines known self-play, GRPO, population-based training",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "Only synthetic web environments; no real-world security evidence",
   "minor": false
  },
  {
   "id": "Q1.3",
   "reviewer": "Q1",
   "text": "Improvements small and lack statistical justification",
   "minor": false
  },
  {
   "id": "Q1.4",
   "reviewer": "Q1",
   "text": "Attack diversity measured only by embedding distance",
   "minor": false
  },
  {
   "id": "Q1.5",
   "reviewer": "Q1",
   "text": "No qualitative insights into emerging attacks or defenses",
   "minor": false
  },
  {
   "id": "Q1.6",
   "reviewer": "Q1",
   "text": "No ablations or theory on why population-based learning helps",
   "minor": false
  },
  {
   "id": "Q2.1",
   "reviewer": "Q2",
   "text": "Task success gain stems from imitation learning; capability actually drops",
   "minor": false
  },
  {
   "id": "Q2.2",
   "reviewer": "Q2",
   "text": "Task success under attack conflates leakage with capability; benign-task evaluation needed",
   "minor": false
  },
  {
   "id": "Q2.3",
   "reviewer": "Q2",
   "text": "Imitation learning warm-up questionable; stronger base models would be fairer",
   "minor": false
  },
  {
   "id": "Q2.4",
   "reviewer": "Q2",
   "text": "Improvements over ART baseline marginal",
   "minor": false
  },
  {
   "id": "Q2.5",
   "reviewer": "Q2",
   "text": "Missing ethics statement and reproducibility section",
   "minor": true
  },
  {
   "id": "Q3.1",
   "reviewer": "Q3",
   "text": "Typos and wrong figure references",
   "minor": true
  },
  {
   "id": "Q3.2",
   "reviewer": "Q3",
   "text": "Criteria for selecting attacker checkpoints unclear",
   "minor": false
  },
  {
   "id": "Q3.3",
   "reviewer": "Q3",
   "text": "Problem setup unrealistic; private data could simply be withheld",
   "minor": false
  },
  {
   "id": "Q4.1",
   "reviewer": "Q4",
   "text": "Code neither provided nor promised",
   "minor": false
  },
  {
   "id": "Q4.2",
   "reviewer": "Q4",
   "text": "Requires white-box access to agent",
   "minor": false
  },
  {
   "id": "Q4.3",
   "reviewer": "Q4",
   "text": "Only two small models tested",
   "minor": false
  },
  {
   "id": "Q4.4",
   "reviewer": "Q4",
   "text": "Compute resources not reported",
   "minor": false
  },
  {
   "id": "Q4.5",
   "reviewer": "Q4",
   "text": "Threat model unrealistic: attacker knows defender function names",
   "minor": false
  },
  {
   "id": "Q4.6",
   "reviewer": "Q4",
   "text": "Injection setup contradicts indirect prompt injection definition",
   "minor": false
  },
  {
   "id": "Q4.7",
   "reviewer": "Q4",
   "text": "Missing evaluation on spotlighting dataset and comparison with that method",
   "minor": false
  },
  {
   "id": "Q4.8",
   "reviewer": "Q4",
   "text": "Differences between BrowserGym and AgentDojo need clarification",
   "minor": true
  },
  {
   "id": "Q4.9",
   "reviewer": "Q4",
   "text": "Missing comparison with instruction-detection defense",
   "minor": false
  }
 ],
