  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "Expectation in estimator cannot be computed from finite data; unaddressed.",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Claim that estimate equals true MI for discrete targets with cross-entropy is questionable.",
