{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Model equals anisotropic RBF or Gaussian-mixture regression; novelty limited",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Related work ignores RBF networks, free-knot splines, adaptive-grid methods",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Universal approximation result is an immediate corollary of Cybenko",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Wasserstein gradient in Theorem 1 is just ordinary parameter gradient; theory thin",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Experiments use Adam/GD, never WFR or Fisher-Rao; WFR crucial-claim unsupported",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "No convergence result established for this geometry",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Several displayed gradient formulas look questionable",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "Gaussian Splatting special-case claim unsubstantiated; real 3DGS pipeline and opacity not covered",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "Interpretations of splatting heuristics as regularization or pruning are speculative",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "No novel-view-synthesis experiment despite being stated motivation",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Experiments are small 1D/2D toy problems",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "No seeds, error bars, or repeated runs",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "MLP and KAN baselines poorly configured and not tuned",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "Missing stronger low-dimensional baselines like RBF, GP, SIREN, Fourier features",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Allen-Cahn setting mild; no comparison with standard numerical solver",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "Parameter-count comparisons not like-for-like; separable test function favours method",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "PINN error metric not clearly defined",
   "minor": true
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Bound implies curse of dimensionality; no evidence for d>=3",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "Per-step computational cost not discussed",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "Numerical stability of matrices A_i not discussed",
   "minor": false
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Overfitting acknowledged but not studied; no regularization proposed",
   "minor": false
  },
  {
   "id": "P1.22",
   "reviewer": "P1",
   "text": "No ablation on mother splat, k, initialization, or optimizer",
   "minor": false
  },
  {
   "id": "P1.23",
   "reviewer": "P1",
   "text": "Many typos, garbled text, duplicated references",
   "minor": true
  },
  {
   "id": "P1.24",
   "reviewer": "P1",
   "text": "Theorem 3 stated informally, not rigorous",
   "minor": false
  },
  {
   "id": "P1.25",
   "reviewer": "P1",
   "text": "Promised instruction manual contribution not delivered",
   "minor": false
  },
  {
   "id": "P1.26",
   "reviewer": "P1",
   "text": "Over-claiming throughout, e.g. vastly outperforming, competing with Chebyshev",
   "minor": false
  },
  {
   "id": "Q1.1",
