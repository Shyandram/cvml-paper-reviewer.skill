{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Tiny per-dataset samples give low power; no CIs or tests for margins and rankings",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Multilingual human scores rest on a single annotator without agreement estimates",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "Small homogeneous annotator pool confounds claimed cultural advantage with annotator identity",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "Claim that models reproduce arbitrary label patterns is untested; no error analysis",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "In-distribution training or contamination as alternative explanation for model advantage not considered",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "Classification protocol incomparable: models use trained probe, humans only guidelines",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Clustering protocol incomparable; human instructions on cluster number unclear; 30 items unstable",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "Reranking scoring from binary labels unclear; agreement statistic odd; pool sizes missing",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "STS compares human integer ratings with model cosine similarity, different instruments",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "Inferring dataset quality from two-annotator agreement is circular; thresholds applied loosely",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Recommendation to replace Emotion and ArXiv clustering not justified",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "Inverse agreement-performance relationship asserted without correlation statistic",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Recommendations conflict regarding STS22",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "Overall score averages heterogeneous metrics with uneven language weighting",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "Inconsistent counts of task pairs across caption and text",
   "minor": true
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "Ill-defined statistics like 67% win rate and 185% of human performance",
   "minor": true
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "Framework contribution thin; essentially a small annotation study",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "Protocol not reproducible: recruitment, payment, training, quality control undescribed",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "Related work on label noise and human label variation brief",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "Low-resource conclusions unsupported; English-only models confound multilingual comparison",
   "minor": false
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Strongest recent multilingual embedding models omitted",
   "minor": false
  },
  {
   "id": "Q1.1",
