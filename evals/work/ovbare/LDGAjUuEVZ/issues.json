{
 "points": [
  {
   "id": "P1.1",
   "reviewer": "P1",
   "text": "Adversarial filtering with the same evaluated systems biases rankings; filter agents chosen circularly.",
   "minor": false
  },
  {
   "id": "P1.2",
   "reviewer": "P1",
   "text": "Uniqueness checked only against alternatives found by five AI systems; ambiguity likely remains.",
   "minor": false
  },
  {
   "id": "P1.3",
   "reviewer": "P1",
   "text": "No independent human audit, inter-annotator agreement or label-noise estimate.",
   "minor": false
  },
  {
   "id": "P1.4",
   "reviewer": "P1",
   "text": "No temporal stability check though answers may change over time.",
   "minor": false
  },
  {
   "id": "P1.5",
   "reviewer": "P1",
   "text": "Difficulty definition operationally weak; conflates question obscurity with browsing skill.",
   "minor": false
  },
  {
   "id": "P1.6",
   "reviewer": "P1",
   "text": "No human baseline solve rate or check that questions are solvable by browsing.",
   "minor": false
  },
  {
   "id": "P1.7",
   "reviewer": "P1",
   "text": "Benchmark may measure parametric knowledge; no browse vs no-browse comparison for same model.",
   "minor": false
  },
  {
   "id": "P1.8",
   "reviewer": "P1",
   "text": "AI search products queried manually via GUI without dates, versions or run counts; not reproducible.",
   "minor": false
  },
  {
   "id": "P1.9",
   "reviewer": "P1",
   "text": "'Search hurts R1' compares different systems, not a controlled ablation; explanation unsupported.",
   "minor": false
  },
  {
   "id": "P1.10",
   "reviewer": "P1",
   "text": "LLMs graded by GPT-4o but products by humans; differing protocols and compliance confound accuracy.",
   "minor": false
  },
  {
   "id": "P1.11",
   "reviewer": "P1",
   "text": "Model categories mix factors; multi-round retrieval claim lacks statistical test.",
   "minor": false
  },
  {
   "id": "P1.12",
   "reviewer": "P1",
   "text": "No confidence intervals or multiple runs; many ranking gaps within noise.",
   "minor": false
  },
  {
   "id": "P1.13",
   "reviewer": "P1",
   "text": "Calibration-increases-with-search claim inconsistent with Table 1 and compares different systems.",
   "minor": false
  },
  {
   "id": "P1.14",
   "reviewer": "P1",
   "text": "Calibration metric (5 bins, verbalized confidence) barely discussed or analysed.",
   "minor": false
  },
  {
   "id": "P1.15",
   "reviewer": "P1",
   "text": "'Reasoning helps' rests on three confounded model pairs; overstated.",
   "minor": false
  },
  {
   "id": "P1.16",
   "reviewer": "P1",
   "text": "No failure analysis.",
   "minor": false
  },
  {
   "id": "P1.17",
   "reviewer": "P1",
   "text": "No per-topic accuracy breakdown.",
   "minor": false
  },
  {
   "id": "P1.18",
   "reviewer": "P1",
   "text": "No analysis of search steps, tool use or cost.",
   "minor": false
  },
  {
   "id": "P1.19",
   "reviewer": "P1",
   "text": "Chinese-specific difficulty claims not demonstrated; no translated or cross-lingual comparison or error taxonomy.",
   "minor": false
  },
  {
   "id": "P1.20",
   "reviewer": "P1",
   "text": "Censorship complexities mentioned in abstract but never addressed.",
   "minor": false
  },
  {
   "id": "P1.21",
   "reviewer": "P1",
   "text": "Validation with Google/Bing, which behave differently in mainland China; effect unclear.",
   "minor": false
  },
  {
   "id": "P1.22",
   "reviewer": "P1",
   "text": "Small scale (289 questions), few items for some topics, annotator-driven coverage.",
   "minor": false
  },
  {
   "id": "P1.23",
   "reviewer": "P1",
   "text": "No contamination protection (canary strings, held-out split, encrypted answers).",
   "minor": false
  },
  {
   "id": "P1.24",
   "reviewer": "P1",
   "text": "Evaluated models dated; open browsing-agent systems not tested.",
   "minor": false
  },
  {
   "id": "P1.25",
   "reviewer": "P1",
   "text": "Comparison with other Chinese search benchmarks qualitative; 'first benchmark' claim needs scoping.",
   "minor": false
  },
  {
   "id": "Q1.1",
   "reviewer": "Q1",
   "text": "Only 289 questions; small scale weakens robustness.",
   "minor": false
  },
  {
   "id": "Q1.2",
   "reviewer": "Q1",
   "text": "Answer uniqueness still depends on model/retrieval limits and annotator creativity.",
   "minor": false
  },
  {
   "id": "Q2.1",
   "reviewer": "Q2",
   "text": "Small dataset scale versus English BrowseComp.",
   "minor": false
  },
  {
   "id": "Q2.2",
   "reviewer": "Q2",
   "text": "Reverse design cannot fully guarantee no alternative valid answers.",
   "minor": false
  },
  {
   "id": "Q2.3",
   "reviewer": "Q2",
   "text": "Dataset contains obvious bugs needing fixes.",
   "minor": false
  },
  {
   "id": "Q2.4",
   "reviewer": "Q2",
   "text": "Insufficiently challenging compared with BrowseComp.",
   "minor": false
  },
  {
   "id": "Q2.5",
   "reviewer": "Q2",
   "text": "Essentially a Chinese adaptation of BrowseComp lacking originality.",
   "minor": false
  },
  {
   "id": "Q3.1",
   "reviewer": "Q3",
   "text": "Creation process mirrors BrowseComp; contribution incremental.",
   "minor": false
  },
  {
   "id": "Q3.2",
   "reviewer": "Q3",
   "text": "Cultural groundedness not empirically verified; evidence exclusivity on Chinese websites unchecked.",
   "minor": false
  },
  {
   "id": "Q3.3",
   "reviewer": "Q3",
   "text": "No failure-mode analysis separating retrieval errors from cultural/linguistic misinterpretation.",
   "minor": false
  },
  {
   "id": "Q4.1",
   "reviewer": "Q4",
   "text": "Incremental: closely mirrors BrowseComp task construction.",
   "minor": false
  },
  {
   "id": "Q4.2",
   "reviewer": "Q4",
   "text": "289 queries insufficient for representativeness and statistical robustness.",
   "minor": false
  },
  {
   "id": "Q4.3",
   "reviewer": "Q4",
   "text": "No analysis whether gaps stem from language change or Chinese web ecosystem; need cross-lingual ablation.",
   "minor": false
  }
 ],
